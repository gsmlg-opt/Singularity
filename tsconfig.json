{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"]
  },
  "include": [
    "apps/singularity_web/assets/**/*.ts",
    "apps/singularity_web/assets/**/*.tsx",
    "playwright.config.ts",
    "test/e2e/**/*.ts",
    "vitest.config.ts"
  ]
}
